{
 "_styles": "menu = italic bold on transparency (colour from grid); header = big heavy italic with a vertical gradient from the grid; block = upright heavy caps; box = white text on the kept black panel with a white frame; plain = upright bold",
 "aEndingTextAntonioGusterTex": {
  "text": "Did you see it, Goroh?!\nDid you see my power?!",
  "style": "box"
 },
 "aEndingTextBabaTex": {
  "text": "My people will erect a\nstatue in my honor!",
  "style": "box"
 },
 "aEndingTextBeastmanTex": {
  "text": "Lookin' for a whoopin'?\nCome to Beastman!",
  "style": "box"
 },
 "aEndingTextBillyTex": {
  "text": "Humans are lame. Monkeys are\ngood! Billy is the BEST!",
  "style": "box"
 },
 "aEndingTextBioRexTex": {
  "text": "Don't judge me by my\nappearance.",
  "style": "box"
 },
 "aEndingTextBlackShadowTex": {
  "text": "You want some of this,\nFalcon?! I'm right here!",
  "style": "box"
 },
 "aEndingTextBloodFalconTex": {
  "text": "There is only one TRUE Falcon!",
  "style": "box"
 },
 "aEndingTextCaptainFalconMasterTex": {
  "text": "I now retire undefeated\nchampion!",
  "style": "box"
 },
 "aEndingTextCaptainFalconStandardExpertTex": {
  "text": "My time has not yet passed.",
  "style": "box"
 },
 "aEndingTextDrClashTex": {
  "text": "The next machine I invent will\nbe even FASTER!",
  "style": "box"
 },
 "aEndingTextDrStewartTex": {
  "text": "My driving skills are\nimpressive, don't you think?",
  "style": "box"
 },
 "aEndingTextDraqTex": {
  "text": "I won! I can't believe it!",
  "style": "box"
 },
 "aEndingTextGomarAndShiohTex": {
  "text": "Two drivers are always better\nthan one!",
  "style": "box"
 },
 "aEndingTextJackLevinTex": {
  "text": "This victory is for all my fans.",
  "style": "box"
 },
 "aEndingTextJamesMcCloudTex": {
  "text": "I drive like a sly fox!",
  "style": "box"
 },
 "aEndingTextJodySummerTex": {
  "text": "Was there ever any doubt\nthat I'd win?",
  "style": "box"
 },
 "aEndingTextJohnTanakaTex": {
  "text": "YEE HAA!  I won!",
  "style": "box"
 },
 "aEndingTextKateAlenTex": {
  "text": "This girl's got some skills!",
  "style": "box"
 },
 "aEndingTextLeonTex": {
  "text": "Fast machines are in my blood.",
  "style": "box"
 },
 "aEndingTextMichaelChainTex": {
  "text": "With this victory, I'll never\nhave to work again!",
  "style": "box"
 },
 "aEndingTextMightyGazelleTex": {
  "text": "Winning makes me feel so\nALIVE!",
  "style": "box"
 },
 "aEndingTextMrEadTex": {
  "text": "Banzai! EAD is the greatest!",
  "style": "box"
 },
 "aEndingTextMrsArrowTex": {
  "text": "The key to victory is technique.",
  "style": "box"
 },
 "aEndingTextOctomanTex": {
  "text": "Takorans are born to race!",
  "style": "box"
 },
 "aEndingTextPicoTex": {
  "text": "What a joke! I was hoping\nfor some competition!",
  "style": "box"
 },
 "aEndingTextRogerBusterTex": {
  "text": "I must be dreaming! I can't\nbelieve I won!",
  "style": "box"
 },
 "aEndingTextSamuraiGorohTex": {
  "text": "I'm the best in the universe!\nRemember that!",
  "style": "box"
 },
 "aEndingTextSilverNeelsenTex": {
  "text": "Not bad for an old timer!",
  "style": "box"
 },
 "aEndingTextSuperArrowTex": {
  "text": "Justice ALWAYS prevails!",
  "style": "box"
 },
 "aEndingTextTheSkullTex": {
  "text": "I am the SUPREME champion!!",
  "style": "box"
 },
 "aEndingTextZodaTex": {
  "text": "Who's the baddest man in\nthe universe?! ME!!",
  "style": "box"
 },
